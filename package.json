{
  "name": "vrm-companion",
  "version": "0.0.5-beta.0",
  "releaseVersion": "0.0.0.5",
  "private": true,
  "description": "Local desktop companion for user-provided VRM avatars",
  "license": "Unlicense",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "dev": "node scripts/build.mjs && node scripts/start.mjs",
    "setup": "node node_modules/electron/install.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"tests/**/*.ts\" \"scripts/*.{mjs,ts}\" package.json tsconfig.json",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"tests/**/*.ts\" \"scripts/*.{mjs,ts}\" package.json tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "node scripts/smoke.mjs",
    "package": "node scripts/package.mjs",
    "check": "npm run typecheck && npm run format:check && npm run build && npm test"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "image-size": "2.0.4",
    "three": "^0.180.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/packager": "20.3.0",
    "@types/node": "^24.19.2",
    "@types/three": "^0.180.0",
    "electron": "44.10.0",
    "esbuild": "0.28.2",
    "playwright": "^1.64.1",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "typescript-api": "npm:typescript@6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
